# Copy to .env.local and fill in. Never commit .env.local.
# OPENAI_API_KEY is read from the Windows environment, never from this file.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
EXPECTED_SUPABASE_REF=
SITE_PASSCODE=
OPENAI_VISION_MODEL=gpt-4o
# Optional: the hospital named on the lead pack. Unset shows "[Hospital name]".
HOSPITAL_NAME=
